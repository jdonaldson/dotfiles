# Font
font-family = Input Mono
font-size = 12

# Cursor
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 2000

# Mouse
mouse-hide-while-typing = true

# Window
window-padding-x = 15
window-padding-y = 15
background-opacity = 1.0
background = 000000
macos-titlebar-style = hidden
macos-non-native-fullscreen = true


# macOS
macos-option-as-alt = false

# Behavior
copy-on-select = true
confirm-close-surface = false
working-directory = home

# Theme (Ghostty ships with this built-in)
theme = Everforest Dark Hard

# Keybinds — clipboard
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard

# Keybinds — scrolling
keybind = ctrl+shift+up=scroll_page_up
keybind = ctrl+shift+down=scroll_page_down
keybind = ctrl+shift+k=scroll_page_up
keybind = ctrl+shift+j=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

# Keybinds — splits
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+]=goto_split:next
keybind = ctrl+shift+[=goto_split:previous

# Keybinds — tabs
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+q=close_surface

# Keybinds — window
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = cmd+enter=toggle_fullscreen

# Keybinds — global (summon from any app)
# Tap Strap 2: four-finger-to-thumb tap → F17 → toggle dropdown terminal
keybind = global:f17=toggle_quick_terminal

# Keybinds — font size
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
