#!/bin/sh
# Run one command against the Curvo DATA account (the default profile's account), past Claude Desktop's
# per-session AWS config, which only knows the Bedrock/test account.
#   curvo-data aws athena list-databases --catalog-name AwsDataCatalog
#   curvo-data python probe.py
# Athena: use --work-group jdonaldson (default output location + 1 TB/query scan cap).
export AWS_CONFIG_FILE="$HOME/.aws/config" \
       AWS_SHARED_CREDENTIALS_FILE="$HOME/.aws/credentials" \
       AWS_PROFILE=curvo-data
# Env creds outrank the profile -- drop any the parent exported.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_BEARER_TOKEN_BEDROCK
# Same wrapper for any command; ~/.local/bin/aws-data is the aws-only sibling.
exec "$@"
