# macOS-specific tmux configuration (sourced from ~/.tmux.conf)

# Default session
new-session -d -s jdonaldson 2>/dev/null

# Prefix key
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# Adaptive status-left: resize hook swaps between compact/full
set-hook -g client-resized 'run-shell -b "bash ~/.claude/popups/adaptive_status.sh"'
set-hook -g session-created 'run-shell -b "bash ~/.claude/popups/adaptive_status.sh"'

# Swap bell sound per session
set-hook -g session-window-changed 'run-shell -b "bash ~/.config/kitty/swap_bell.sh"'

# Fuzzy line yank: prefix+I — capture scrollback to clipboard
bind I run-shell -b 'tmux capture-pane -p -S -500 > /tmp/tmux_fzf_buf.txt && tmux display-popup -w 80% -h 60% -E "bash ~/.claude/popups/tmux_yank.sh"'

# Inquiry mode: prefix+i — capture scrollback, fzf pick, paste as follow-up question
bind i run-shell -b 'tmux capture-pane -e -p -S -500 > /tmp/tmux_fzf_buf.txt && tmux display-popup -B -w 100% -h 100% -E "bash ~/.claude/popups/tmux_inquiry.sh #{pane_id}"'

# Copy to system clipboard (macOS)
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi Enter send -X copy-pipe-and-cancel "pbcopy"

# Tap Strap 2 → window switching (custom TapMap sends F13–F16, no prefix)
# index+thumb=F13→win1, middle+thumb=F14→win2, ring+thumb=F15→win3, pinky+thumb=F16→win4
# tmux has no built-in F13–F16 keys; define user-keys matching xterm-ghostty terminfo
set -s user-keys[0] "\e[1;2P"
set -s user-keys[1] "\e[1;2Q"
set -s user-keys[2] "\e[1;2R"
set -s user-keys[3] "\e[1;2S"
bind -n User0 select-window -t :1
bind -n User1 select-window -t :2
bind -n User2 select-window -t :3
bind -n User3 select-window -t :4

# Spotify controls (prefix keys + click on status bar icon)
bind p run-shell "osascript -e 'tell application \"Spotify\" to playpause'"
bind -n MouseDown1Status \
  if -F '#{==:#{mouse_status_range},cpu}' { display-popup -T " CPU (q to close) " -w 90% -h 80% -E "btop --preset 0" } { \
  if -F '#{==:#{mouse_status_range},mem}' { display-popup -T " Memory (q to close) " -w 90% -h 80% -E "btop --preset 1" } { \
  if -F '#{==:#{mouse_status_range},net}' { display-popup -T " Network (q to close) " -w 90% -h 80% -E "sudo bandwhich" } { \
  if -F '#{==:#{mouse_status_range},spotify}' { run-shell "osascript -e 'tell application \"Spotify\" to playpause'" } { \
  if -F '#{==:#{mouse_status_range},slack}' { run-shell "open -a Slack" } { \
  select-window -t = } } } } }
bind > run-shell "osascript -e 'tell application \"Spotify\" to next track'"
bind < run-shell "osascript -e 'tell application \"Spotify\" to previous track'"
bind + run-shell "osascript -e 'set volume output volume ((output volume of (get volume settings)) + 10)'"
bind - run-shell "osascript -e 'set volume output volume ((output volume of (get volume settings)) - 10)'"

# Slack controls
bind s display-popup -T " Slack Status " -w 40% -h 30% -E "bash ~/.claude/popups/slack_set_status.sh"
bind S run-shell "bash ~/.claude/popups/slack_toggle_presence.sh"

# Opacity picker (fzf live preview)
bind o display-popup -E -w 30 -h 14 -T " Opacity " "bash ~/.claude/popups/opacity_picker.sh"

# Status left + right: single source of truth is ~/.claude/popups/adaptive_status.sh
# (also re-run by the client-resized / session-created hooks above). Do NOT set
# status-left/status-right literals here — they drift and the hooks clobber them.
set -g status-left-length 80
set -g status-right-length 180
run-shell -b "bash ~/.claude/popups/adaptive_status.sh"
set -g status-justify left

# Inactive windows: muted pills with rounded edges
setw -g window-status-format '#[fg=#2e383c,bg=default]#[fg=#859289,bg=#2e383c] #I #(cat ~/.claude/popups/status/#{pane_pid} 2>/dev/null)#(cat ~/.claude/popups/labels/#{pane_pid} 2>/dev/null) #[fg=#2e383c,bg=default]'
# Active window: green pill with rounded edges
setw -g window-status-current-format '#[fg=#a7c080,bg=default]#[fg=#232a2e,bg=#a7c080,bold] #I #(cat ~/.claude/popups/status/#{pane_pid} 2>/dev/null)#(cat ~/.claude/popups/labels/#{pane_pid} 2>/dev/null) #[fg=#a7c080,bg=default]'
