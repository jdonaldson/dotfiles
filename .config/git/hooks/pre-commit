#!/bin/bash
#
# Global pre-commit hook
#

# --- Haxe repo: block CHANGES.txt edits on feature branches ---
# CHANGES.txt entries are added during merges to development, not on feature branches.

if git diff --cached --name-only | grep -q '^extra/CHANGES.txt$'; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    case "$branch" in
        development|main|master|HEAD)
            ;;  # allow on main branches and during rebase/merge
        *)
            echo "ERROR: extra/CHANGES.txt should not be modified on feature branches."
            echo "  CHANGES.txt entries are added during merges to development."
            echo "  Branch: $branch"
            echo ""
            echo "To bypass (e.g. during rebase conflict resolution):"
            echo "  git commit --no-verify"
            tput bel 2>/dev/null || true
            exit 1
            ;;
    esac
fi

# --- Haxe repo: validate CHANGES.txt section placement ---
# Catches the common mistake of adding new features to "Bugfixes"
# or bug fixes to "General improvements".

if git diff --cached --name-only | grep -q '^extra/CHANGES.txt$'; then
    staged_file=$(git show :extra/CHANGES.txt 2>/dev/null)
    if [[ -n "$staged_file" ]]; then
        added_lines=$(git diff --cached -U0 -- extra/CHANGES.txt | grep '^+[^+]' | sed 's/^+//')
        errors=0

        while IFS= read -r entry; do
            if [[ "$entry" =~ ^[[:space:]]*$ ]]; then continue; fi
            if echo "$entry" | grep -qE '^\s+[A-Z].*:$'; then continue; fi
            if [[ "$entry" =~ ^[0-9]{4}- ]]; then continue; fi

            line_num=$(echo "$staged_file" | grep -nF "$entry" | head -1 | cut -d: -f1)
            if [[ -z "$line_num" ]]; then continue; fi

            section=$(echo "$staged_file" | head -n "$line_num" | grep -E $'^\t[A-Z].*:$' | tail -1 | sed $'s/^\t//' | sed 's/:$//')
            if [[ -z "$section" ]]; then continue; fi

            entry_lower=$(echo "$entry" | tr '[:upper:]' '[:lower:]')

            if [[ "$section" == "Bugfixes" ]]; then
                if echo "$entry_lower" | grep -qiE '\badd[s ]|\bnew\b|\bsupport\b|\bimplement'; then
                    echo "CHANGES.txt: entry looks like a feature but is in \"Bugfixes\":"
                    echo "  $entry"
                    echo "  -> Should this be in \"General improvements\"?"
                    errors=$((errors + 1))
                fi
            elif [[ "$section" == "General improvements" ]]; then
                if echo "$entry_lower" | grep -qE ': fix\b'; then
                    echo "CHANGES.txt: entry looks like a bug fix but is in \"General improvements\":"
                    echo "  $entry"
                    echo "  -> Should this be in \"Bugfixes\"?"
                    errors=$((errors + 1))
                fi
            fi
        done <<< "$added_lines"

        if [[ $errors -gt 0 ]]; then
            echo ""
            echo "Found $errors possible CHANGES.txt section misplacement(s)."
            echo "If intentional, commit with --no-verify to bypass."
            tput bel 2>/dev/null || true
            exit 1
        fi
    fi
fi

# --- Haxe repo: reject target-conditional gates in pure-Haxe issue tests ---
# Pure Haxe tests should run on all targets — don't wrap them in #if lua / #if python etc.
# Only use #if when the test imports target-specific APIs (e.g., lua.Table, python.Lib).

if git diff --cached --name-only | grep -q 'tests/unit/src/unit/issues/'; then
    for f in $(git diff --cached --name-only -- 'tests/unit/src/unit/issues/*.hx'); do
        [ -f "$f" ] || continue
        staged=$(git show ":$f")

        if echo "$staged" | grep -qE '#if (lua|python|cpp|cs|java|jvm|js|flash|hl|neko|eval|lua_jit)'; then
            if echo "$staged" | grep -qE 'import (lua|python|cpp|cs|java|jvm|js|flash|hl|neko|eval)\.'; then
                continue
            fi
            echo ""
            echo "ERROR: $f has a target conditional (#if ...) but no target-specific imports."
            echo "  Pure Haxe tests should run on all targets — remove the #if gate."
            echo "  Only use #if when the test uses target-specific APIs (e.g., lua.Table, python.Lib)."
            echo ""
            tput bel 2>/dev/null || true
            exit 1
        fi
    done
fi

# --- Python repos with ruff config: lint + format check on staged files ---
# Mirrors the CI lint step (ruff check && ruff format --check) so lint failures
# surface at commit time instead of breaking CI. Scoped to repos that opt in
# via [tool.ruff] in pyproject.toml or a ruff.toml.

if command -v ruff >/dev/null 2>&1; then
    top=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -n "$top" ]] && { grep -qs '^\[tool\.ruff' "$top/pyproject.toml" || [[ -f "$top/ruff.toml" || -f "$top/.ruff.toml" ]]; }; then
        staged_py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
        if [[ -n "$staged_py" ]]; then
            ruff_failed=0
            echo "$staged_py" | tr '\n' '\0' | xargs -0 ruff check --quiet || ruff_failed=1
            echo "$staged_py" | tr '\n' '\0' | xargs -0 ruff format --check --quiet || ruff_failed=1
            if [[ $ruff_failed -ne 0 ]]; then
                echo ""
                echo "ERROR: ruff lint/format check failed on staged Python files."
                echo "  Fix with:  ruff check --fix <files> && ruff format <files>"
                echo "  Then re-stage and commit. Bypass with: git commit --no-verify"
                tput bel 2>/dev/null || true
                exit 1
            fi
        fi
    fi
fi

exit 0
