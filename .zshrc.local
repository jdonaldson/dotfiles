
source ~/.aliases
export LESS=eFRX

export XDG_CONFIG_HOME=~/.config

maybeSource(){
   test -f $1 && . $1
}
maybePath(){
   test -d $1 && export PATH=$1:$PATH
}

maybePathAppend(){
   test -d $1 && export PATH=$PATH:$1
}

# Conda initialization (checks common locations)
for conda_path in /opt/homebrew/Caskroom/miniconda/base $HOME/miniconda3; do
  if [ -f "$conda_path/bin/conda" ]; then
    __conda_setup="$("$conda_path/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
    if [ $? -eq 0 ]; then
      eval "$__conda_setup"
    else
      [ -f "$conda_path/etc/profile.d/conda.sh" ] && . "$conda_path/etc/profile.d/conda.sh"
    fi
    unset __conda_setup
    break
  fi
done


# Homebrew (Apple Silicon or Intel) — runs only where brew exists;
# sets PATH/MANPATH/INFOPATH/HOMEBREW_PREFIX correctly.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [[ -x $_brew ]] && eval "$("$_brew" shellenv)" && break
done
unset _brew

# Haxe stdlib — only if present
[[ -d /opt/homebrew/lib/haxe/std ]] && export HAXE_STD_PATH="/opt/homebrew/lib/haxe/std"


maybePath ~/.local/bin
maybePath ~/bin

maybeSource ~/.apikeys
maybeSource ~/.comrc.sh

[[ "$OSTYPE" == darwin* ]] && code () { VSCODE_CWD="$PWD" open -n -b "com.microsoft.VSCode" --args $* ;}

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Auto-attach to tmux (skip in IDE terminals or if ~/.no-tmux exists)
# On Linux boxes, only auto-attach for SSH logins — keeps local/console and
# non-interactive shells out of tmux, and avoids surprise nesting.
if [[ "$OSTYPE" != darwin* && -z "$SSH_TTY" ]]; then
  : # not an SSH session on a server: skip auto-attach
elif ! command -v tmux >/dev/null 2>&1; then
  : # no tmux on this machine
elif [[ ! -f ~/.no-tmux && -z "$TMUX" && -z "$INSIDE_EMACS" && -z "$VSCODE_PID" && -z "$TERM_PROGRAM_VERSION" ]]; then
  session_name="default"
  tmux has-session -t=$session_name 2> /dev/null
  if [[ $? -ne 0 ]]; then
     TMUX='' tmux new-session -d -s "$session_name" -c "$HOME"
  fi
  tmux attach -t "$session_name"
fi

# Auto-name tmux windows based on git repo or directory
_tmux_auto_title() {
  [[ -z "$TMUX" ]] && return
  local name
  name=$(git rev-parse --show-toplevel 2>/dev/null | xargs basename) \
    || name=$(basename "$PWD")
  tmux rename-window "$name"
}
precmd_functions+=(_tmux_auto_title)

# fbd - delete git branch (including remote branches)
fbd() {
  local branches branch
  branches=$(git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format="%(refname:short)") &&
  branch=$(echo "$branches" | fzf --multi ) &&
  git branch -D $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh)"


export COLORSCHEME="everforest dark hard"

# Set kitty theme (run manually with `set-theme` or `set-theme <name>`)
set-theme() {
  local theme="${1:-$COLORSCHEME}"
  kitten themes --reload-in=all "$theme"
}

# direnv configuration
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
# add this note for posterity
#


#
# Default Ollama model
export OLLAMA_MODEL="gpt-oss:20b"

# Machine-/work-specific shell config (not tracked in public dotfiles).
[[ -f ~/.zshrc.work ]] && source ~/.zshrc.work
