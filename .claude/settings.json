{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(python3 ~/.claude/*)",
      "Bash(ls:*)",
      "Bash(tput:*)",
      "Bash(printf:*)",
      "Bash(kitty:*)",
      "Bash(tmux display-popup:*)",
      "Bash(tpopup:*)",
      "Bash(tpython:*)",
      "Bash(tdialog:*)",
      "Write(~/.claude/popups/*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(python /tmp/claude-*/*)",
      "Bash(python3 /tmp/claude-*/*)",
      "Bash(python /var/folders/*)",
      "Bash(python3 /var/folders/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-cwd.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tool-status.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Projects",
        "~/.cache",
        "/tmp",
        "/Volumes/Models",
        "~/Library/Application Support/quarto",
        "~/Library/Caches/quarto",
        "~/.ipython",
        "~/.jupyter"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.netrc",
        "~/.dotfiles"
      ]
    }
  },
  "additionalDirectories": [
    "/tmp",
    "/private/tmp",
    "/Volumes/Models"
  ],
  "feedbackSurveyState": {
    "lastShownTime": 1754081223717
  },
  "mcpServers": {
    "zen": {
      "command": "uv",
      "args": [
        "--directory",
        "/Users/jdonaldson/Projects/maze/zen-mcp-server",
        "run",
        "zen-mcp-server"
      ]
    },
    "Roblox Studio": {
      "command": "/Applications/RobloxStudioMCP.app/Contents/MacOS/rbx-studio-mcp",
      "args": [
        "--stdio"
      ]
    },
    "browser-screenshot": {
      "command": "node",
      "args": [
        "/Users/jdonaldson/.claude/mcp-servers/browser-screenshot/index.js"
      ]
    }
  }
}
